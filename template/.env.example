# Django Settings
# ATENÇÃO: este arquivo NÃO contém nenhum segredo utilizável. SECRET_KEY,
# DATABASE_URL (com a senha), POSTGRES_PASSWORD, REDIS_PASSWORD e
# CELERY_BROKER_URL são gerados no passo de configuração do ambiente.
# Valores com '$' DEVEM ir entre ASPAS SIMPLES: o Compose interpola '$x' em
# valores sem aspas ou entre aspas duplas (mutila no container); entre aspas
# simples, Compose e python-decouple leem o valor integral.
# Gere a SECRET_KEY com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8000,http://127.0.0.1:8080,http://127.0.0.1:8000
# Nome de exibição nos templates (navbar, títulos das páginas, rodapé).
SITE_NAME=django-setup-copier

# Banco de dados
# DATABASE_URL é consumida pelo Django (dj-database-url); POSTGRES_* são
# consumidas pelo container do Postgres (a senha precisa ser a mesma nos dois).
DATABASE_URL=postgres://postgres:SENHA@db:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Redis / Celery
REDIS_PASSWORD=
# Vazio: tarefas Celery executam eager (na hora, na própria requisição) —
# dev simples, sem worker. Preenchido: o serviço `worker` do Compose consome
# a fila (e-mails de cadastro/reset saem de forma assíncrona).
CELERY_BROKER_URL=

# E-mail
# Em dev, o backend de console imprime a mensagem legível no runserver.
EMAIL_BACKEND=shared.email_backends.ConsoleEmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost

# Produção com SendGrid (SMTP): descomente a linha EMAIL_BACKEND abaixo,
# preencha os dados da conta e ajuste o DEFAULT_FROM_EMAIL acima para um
# remetente verificado no painel do SendGrid. Nada no código precisa mudar.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.sendgrid.net
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_HOST_USER=apikey
#EMAIL_HOST_PASSWORD=
# Timeout de socket do SMTP em segundos (default do Django: esperar
# indefinidamente - um SMTP travado pendura o worker sem disparar retry).
#EMAIL_TIMEOUT=30

# Alternativa sem servidor de e-mail: Web App do Google Apps Script que
# recebe POST {to, subject, body} e chama MailApp.sendEmail (mesmo contrato
# do serviço de e-mail do projeto Imprensa — o mesmo script serve para os
# dois). O script de referência está em .docs/apps_script_email.gs, com as
# instruções de publicação. Cotas do Google: 100 destinatários/dia (Gmail
# comum), 1.500/dia (Workspace) — por conta Google que executa o script.
# Para mais capacidade, implante o mesmo script em outras contas (mesmo
# AUTH_TOKEN) e liste as URLs do /exec separadas por vírgula: esgotada a
# cota da primeira, o backend roteia para a próxima. O token é opcional:
# se definido, o backend o envia no payload do POST e o doPost do script
# recusa sem ele (Web Apps não enxergam cabeçalhos HTTP, por isso não vai
# em Authorization).
#EMAIL_BACKEND=shared.email_backends.AppsScriptEmailBackend
#APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec
# Fila com um deploy por conta Google:
#APPS_SCRIPT_URL=https://script.google.com/macros/s/SCRIPT_ID_1/exec,https://script.google.com/macros/s/SCRIPT_ID_2/exec
#APPS_SCRIPT_TOKEN=
#APPS_SCRIPT_TIMEOUT=30

# Segurança de transporte e cookies (ver "Endurecimento de segurança" nas Notas Importantes)
# Desenvolvimento local sobre HTTP: mantenha False/0.
# Produção sobre HTTPS: SESSION_COOKIE_SECURE=True, CSRF_COOKIE_SECURE=True,
# SECURE_SSL_REDIRECT=True e SECURE_HSTS_SECONDS=31536000 — o startup EXIGE as três primeiras.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
